    framesPerSecond = 60
    startTimeCode = 0
    endTimeCode = 66
    customLayerData = {
        string generator = "stylized_gait reference animation generator"
        string paper = "Hopkins et al., Interactive Design of Stylized Walking Gaits for Robotic Characters, ACM TOG 2024"
        string robot = "qmini_urdf-2legs"
        string sample = "step_in_place"
    }
)

