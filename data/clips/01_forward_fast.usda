    # ---- Tab. 3 sample identity (SI units: m/s, rad/s) ----
    custom string stylizedGait:sampleName = "forward_fast"
    custom string stylizedGait:notes = "Tab. 3 Forward Fast. Longest stride, most pronounced toe-off."
    custom double3 stylizedGait:velocity_mps_radps = (0.35, 0, 0)
    custom double3 stylizedGait:cycleDisplacement_m_rad = (0.28, 0, 0)
    custom double stylizedGait:cyclePeriod = 0.8

    # ---- Tab. 1 time intervals (min, max), seconds from cycle start ----
    custom double2 stylizedGait:interval:CY = (0, 0.8)
    custom double2 stylizedGait:interval:LS = (0, 0.288)
    custom double2 stylizedGait:interval:RS = (0.4, 0.688)

